# Neon PostgreSQL pooled connection string
DATABASE_URL=

# Clerk keys (from your Clerk dashboard → API Keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (from Clerk dashboard → Webhooks → your endpoint → Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=

# Server port (defaults to 3000 if not set)
PORT=3000
